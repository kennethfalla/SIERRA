# ============================================================
# Sierra Environmental Reporting System - Apache/.htaccess
# Tuned for InfinityFree (Apache 2.4). This app routes through
# index.php?page=... so NO URL rewriting is needed here.
# ============================================================

# Disable directory listing (e.g. /uploads/)
Options -Indexes

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Deny direct access to hidden files / dotfiles (.htaccess, .gitignore ...)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Deny direct access to deployment/dev-only files
#  - database.sql is imported via phpMyAdmin, never served
#  - debug_sms.php / test_reset_password.php are local dev tools
#  - env.php holds DB passwords and is served from config/ (also blocked there)
<FilesMatch "^(database\.sql|debug_sms\.php|test_reset_password\.php|env\.php|env\.php\.example)$">
    Require all denied
</FilesMatch>

# Deny direct web access to the geojson assignment tool (CLI/dev only)
<FilesMatch "^assign_reports_to_barangays\.php$">
    Require all denied
</FilesMatch>

# Gzip text-based responses for faster page loads
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>