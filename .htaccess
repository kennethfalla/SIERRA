# Sierra Environmental Reporting System
# Minimal, robust front controller: serve real files directly, and send
# anything else to index.php (preserving the query string). No redirects,
# no clean-URL rewrites — so nothing can be cached or loop.
RewriteEngine On

# ============================================
# PERFORMANCE: GZIP COMPRESSION
# ============================================
# Compresses text-based assets before sending them over the wire. This is the
# single biggest win for mobile-data users because HTML/CSS/JS/JSON compress
# extremely well (typically 70-80% smaller).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/xhtml+xml image/svg+xml
    AddOutputFilterByType DEFLATE application/x-font-ttf application/x-font-opentype application/font-woff application/font-woff2
    # Exclude already-compressed formats
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|mp4|mp3|zip|gz)$ no-gzip dont-vary
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# ============================================
# PERFORMANCE: CACHE-CONTROL HEADERS
# ============================================
# Static assets are versioned, so cache them aggressively. HTML (PHP pages)
# must never be cached or users would see stale data.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Static assets get a long cache lifetime (matched with mod_expires above).
    <FilesMatch "\.(css|js|png|jpe?g|gif|webp|svg|woff2?|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Never cache dynamic PHP pages.
    <FilesMatch "\.(php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>

# ============================================
# FRONT CONTROLLER (routing)
# ============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
