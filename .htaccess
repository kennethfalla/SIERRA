# Sierra Environmental Reporting System - Clean URLs
# Hides the app folder and index.php?page= from the address bar.
# Location-independent: works at the domain root (live) and in a subfolder (local).

RewriteEngine On

# ------------------------------------------------------------------
# 1) 301 redirect: old /index.php?page=X[&extra] -> clean /X[?extra]
#    GET only - settings/forgot-password/reset-password POST forms
#    keep working (a 301 on POST would drop the submitted data).
# ------------------------------------------------------------------
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{THE_REQUEST} \s/+index\.php\?page=([a-zA-Z0-9_-]+)(?:&([^\s]*))?\s [NC]
RewriteRule ^ %1?%2 [R=301,L,NE]

# ------------------------------------------------------------------
# 2) Serve existing files/directories directly (assets, uploads,
#    controllers, views, geojson...).
# ------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ------------------------------------------------------------------
# 3) Clean URLs: /login -> index.php?page=login (extra params kept)
# ------------------------------------------------------------------
RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?page=$1 [L,QSA]

# ------------------------------------------------------------------
# 4) Fallback: anything else goes to the front controller.
# ------------------------------------------------------------------
RewriteRule ^ index.php [L]