<?php
// ============================================================
// config/env.php.example - Per-deployment configuration
// ------------------------------------------------------------
// HOW TO USE
//  1. Copy/rename this file to  config/env.php
//     (env.php is gitignored, so your credentials never get committed).
//  2. Fill in your database credentials from the InfinityFree
//     control panel:  MySQL Databases -> (your DB) -> Show Credentials.
//  3. Upload env.php together with the rest of the app.
//
// REQUIRED: PHP 8.0+  (the app uses match(), and other PHP 8 features).
//            InfinityFree currently runs PHP 8.x - select it under
//            Control Panel -> PHP settings if asked.
// ============================================================

// --- MySQL credentials (InfinityFree vPanel) ---
define('DB_HOST', 'sqlXXX.epizy.com');          // Your InfinityFree MySQL host
define('DB_PORT', '3306');
define('DB_NAME', 'if0_00000000_yourdbname');   // Your assigned database name
define('DB_USER', 'if0_00000000');              // Your assigned username
define('DB_PASSWORD', 'your-database-password');

// --- Optional overrides ---
// Force the app environment. Auto-detected normally:
//   * 'development' -> PHP errors shown on screen (local XAMPP)
//   * 'production'  -> errors logged, never shown (live servers)
// define('APP_ENV', 'production');